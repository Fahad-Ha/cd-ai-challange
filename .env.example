# --- Supabase (public: shipped to the browser, safe by design; RLS does the protecting) ---
NEXT_PUBLIC_SUPABASE_URL=https://zthrdbbunspivagzwdjd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy "anon" key

# --- Scripts only (seed + tampering test). NEVER referenced by app code. ---
SUPABASE_SECRET_KEY=sb_secret_...                          # or the legacy "service_role" key

# --- AI image description (server-only; no NEXT_PUBLIC_ prefix on purpose) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Only for pushing migrations to the hosted project without CLI login:
#     npx supabase db push --db-url "$SUPABASE_DB_URL"   (use the Session pooler string) ---
SUPABASE_DB_URL=
